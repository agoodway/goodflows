#!/usr/bin/env bash
# Fake in-Sprite service manager: starts the service command in its own session.
set -u
[ "${1:-}" = services ] || { echo "fake sprite-env: unsupported" >&2; exit 2; }
op="$2" name="$3"
shift 3
pidfile="$HOME/.service-$name.pid"
case "$op" in
  delete)
    [ -e "$pidfile" ] && kill -KILL -- "-$(cat "$pidfile")" 2>/dev/null
    rm -f "$pidfile"
    ;;
  create)
    cmd="" args="" dir="$HOME"
    while [ $# -gt 0 ]; do
      case "$1" in
        --cmd) cmd="$2"; shift 2 ;;
        --args) args="$2"; shift 2 ;;
        --dir) dir="$2"; shift 2 ;;
        *) shift ;;
      esac
    done
    IFS=, read -r -a argv <<< "$args"
    cd "$dir" || exit 1
    setsid "$cmd" "${argv[@]}" </dev/null >>"$HOME/.service-$name.log" 2>&1 &
    echo $! > "$pidfile"
    echo "service $name started"
    ;;
  *) echo "fake sprite-env: unsupported op $op" >&2; exit 2 ;;
esac
